# Kast — environment variables
# Copy to .env and fill in any values you want to override.
# All variables are optional — sensible defaults are applied at startup.

# ── Server ────────────────────────────────────────────────────────────────────

# Publicly reachable URL of the Kast server (used in generated HLS playlist URLs).
# Set this to your domain or public IP so streams work from outside the host.
# Example: https://radio.example.com  or  http://203.0.113.10:8080
KAST_PUBLIC_URL=

# Admin API key — leave empty to auto-generate a random one on first run.
# Also saved as "apiKey" on mobile-app users in Firestore, so set it if you use
# Access → "Usuário do Aplicativo".
# The generated key is printed to the server log on startup.
# You can also enter it later in Dashboard → Settings → Connection.
KAST_API_KEY=

# JWT signing secret — leave empty to auto-generate.
KAST_JWT_SECRET=

# CORS origin for the dashboard (single value).
# Only needed if you host the dashboard on a different domain/port than the server.
# Example: https://dashboard.example.com
KAST_CORS_ORIGINS=

# ── Reverse proxy (Caddy) ─────────────────────────────────────────────────────
# The caddy service terminates HTTPS with automatic Let's Encrypt certificates.
# Each domain needs a DNS A record pointing at this host; open ports 80 + 443.
# When using Caddy, leave the KAST_SSL_* variables below empty and set
# KAST_PUBLIC_URL=https://<KAST_API_DOMAIN>.

# Domain for the Kast server (API, streams, HLS) — the URL the Android app uses.
# Also saved as "kastUrl" (https://<domain>/) on mobile-app users in Firestore.
# Example: api.example.com
KAST_API_DOMAIN=

# Domain for the dashboard. Also set KAST_CORS_ORIGINS=https://<this domain>.
# Example: app.example.com
KAST_DASHBOARD_DOMAIN=

# Optional e-mail for Let's Encrypt expiry notices (uncomment in Caddyfile).
ACME_EMAIL=

# ── SSL / HTTPS (built-in, without Caddy) ───────────────────────────────────────────────────────────────
# See README → Production Deployment for full setup guides.

# Enable HTTPS. Set to "true" to activate the SSL listener.
# Also requires either cert files (below) or SSL_DOMAINS for auto-cert.
KAST_SSL_ENABLED=

# Paths to TLS certificate and key inside the container.
# Used for Cloudflare Origin Cert or any manually obtained certificate.
# Example: /app/certs/origin.pem  (mount ./certs:/app/certs:ro in compose)
KAST_SSL_CERT_FILE=
KAST_SSL_KEY_FILE=

# Comma-separated domain(s) for Let's Encrypt auto-cert.
# Requires port 443 reachable from the internet and no Cloudflare proxy.
# Example: radio.example.com
KAST_SSL_DOMAINS=

# Set to "true" when running behind Cloudflare or any reverse proxy.
# Enables reading the real client IP from the proxy header below.
# Defaults to "true" in docker-compose.yml (Caddy is in front).
KAST_TRUST_PROXY=

# HTTP header to read the real client IP from when KAST_TRUST_PROXY=true.
# Use "CF-Connecting-IP" behind Cloudflare, leave empty for X-Forwarded-For (default).
KAST_PROXY_HEADER=

# ── Dashboard ─────────────────────────────────────────────────────────────────

# Host port the dashboard listens on (default: 3000), bound to 127.0.0.1 only.
# Public access goes through the caddy service.
DASHBOARD_PORT=3000

# Internal URL the Next.js server uses to proxy API requests to the backend.
# Use the Docker service name when running via docker compose (default below).
# Change only if you rename the server service or run it on a different port.
# API_URL=http://server:8080

# ── Mobile-app users (Firebase) ───────────────────────────────────────────────
# Used by Dashboard → Access → "Usuário do Aplicativo" to create Firebase Auth
# users and their Firestore "Users/{uid}" documents. Server-side only.

# Firebase service-account JSON (Firebase console → Project settings →
# Service accounts → Generate new private key). Paste it base64-encoded:
#   base64 -i serviceAccount.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=

# The app users' "apiKey" is the KAST_API_KEY value (Server section above), so
# it must be set explicitly — an auto-generated key is unknown to the dashboard.

# The app users' "kastUrl" is built from KAST_API_DOMAIN (Reverse proxy section
# above) as https://<KAST_API_DOMAIN>/.
